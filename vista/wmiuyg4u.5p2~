                    txtPaciente.Text = paciente.Apellido + ", " + paciente.Nombre;
                    txtObraSocial.Text = ObraSocial(paciente.IdObraSocial);

                }
                else
                {
                    MessageBox.Show("No se encontró ningún paciente con el DNI proporcionado.");
                }
            }
        }

