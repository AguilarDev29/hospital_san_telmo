        private void ObtenerDiasMedico()
        {
            string query = "SELECT dia FROM (SELECT DISTINCT dia FROM horario_medico WHERE id_medico = @idMedico) AS DistinctDias " +
                           "ORDER BY CASE dia " +
                           "WHEN 'LUNES' THEN 1 " +
                           "WHEN 'MARTES' THEN 2 " +
                           "WHEN 'MIERCOLES' THEN 3 " +
                           "WHEN 'JUEVES' THEN 4 " +
                           "WHEN 'VIERNES' THEN 5 " +
                           "WHEN 'SABADO' THEN 6 " +
                           "WHEN 'DOMINGO' THEN 7 " +
                           "END;";

            using (SqlConnection conn = Conexion.Conectar())
            {
                SqlCommand cmd = new SqlCommand(query, conn);
                cmd.Parameters.AddWithValue("@idMedico", IdMedico(cbMedico.Text));
                SqlDataReader reader = cmd.ExecuteReader();
                lbDiasMedico.Items.Clear();
                while (reader.Read())
                {
                    lbDiasMedico.Items.Add(reader.GetString(0));
                }
            }
        }


        private int IdHorario(string horario)
        {
            string query = "string query = \"SELECT hm.id FROM horario_medico hm" + 
                "JOIN horario_clinica hc ON hm.id_horario = hc.id" 
                + "WHERE hc.horario = @horario AND hm.id_medico = @idMedico;";
            using (SqlConnection conn = Conexion.Conectar())
            {
                SqlCommand cmd = new SqlCommand(query, conn);
                cmd.Parameters.AddWithValue("@horario", horario);
                SqlDataReader reader = cmd.ExecuteReader();
                if (reader.Read())
                {
                    return reader.GetInt32(0);
                }
                else
                {
                    return -1;
                }
            }
        }

        private void btnCancelar_Click(object sender, EventArgs e)
        {
            if (txtDni.Text == "" || txtPaciente.Text == "")
            {
                MessageBox.Show("Ingrese un paciente antes de continuar", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            var respuesta = MessageBox.Show("¿Desea reagendar el turno?", "Reagendar", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Question);
            if (respuesta == DialogResult.Yes)
            {
                reagendarTurno = new ReagendarTurno(IdPaciente(txtDni.Text));
                reagendarTurno.Show();
            }
            if (respuesta == DialogResult.No)
            {
                cancelarTurno = new CancelarTurno(IdPaciente(txtDni.Text));
                cancelarTurno.Show();
            }
        }

        private void btnTurnoMasReciente_Click(object sender, EventArgs e)
        {
            DateTime fecha = DateTime.Today.Date;
            DateTime fechaLimite = fecha.AddYears(1);
            actualizandoFecha = true;
            while (fecha <= fechaLimite)
            {
                string diaSemana = ObtenerDiaSemana(fecha);
                if (lbDiasMedico.Items.Contains(diaSemana))
                {
                    CargarHorariosDisponibles(fecha, IdMedico(cbMedico.Text));
                    if (cbHorario.Items.Count > 0)
                    {
                        cbHorario.SelectedIndex = 0;
                        pFecha.Value = fecha;
                        actualizandoFecha = false;
                        return;
                    }
                }
                fecha = fecha.AddDays(1);
                pFecha.Value = fecha;
            }
            actualizandoFecha = false;
            MessageBox.Show("No hay turnos disponibles en el próximo año", "Información", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private void txtDni_Validating(object sender, System.ComponentModel.CancelEventArgs e)
        {
            if (!txtDni.Text.All(char.IsDigit))
            {
                MessageBox.Show("El DNI debe ser unicamente compuesto por numeros",
                "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                txtDni.Focus();
            }
        }

        private void txtApellido_Validating(object sender, System.ComponentModel.CancelEventArgs e)
        {
            if (!txtApellido.Text.All(char.IsLetter))
            {
                MessageBox.Show("El apellido debe ser unicamente compuesto por letras",
                "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                txtApellido.Focus();
            }
        }
