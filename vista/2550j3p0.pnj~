        private void txtTelefono_Validating(object sender, System.ComponentModel.CancelEventArgs e)
        {
            if(!Regex.IsMatch(txtTelefono.Text, "^(?:(?:0?([1-9]\\d{0,3}))|([1-9]\\d{0,3}))\\d{6,8}$"))
